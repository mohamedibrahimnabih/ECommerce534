@model BrandWithFilterVM

<main>
    <div class="container-fluid px-4">
        <h1 class="mt-4">Brands</h1>
        <ol class="breadcrumb mb-4">
            <li class="breadcrumb-item"><a href="#">Dashboard</a></li>
            <li class="breadcrumb-item active">Brands</li>
        </ol>

        <div class="card mb-3">
            <div class="card-body">
                <form action="/Admin/Brand/index">
                    <div class="input-group">
                        <input type="text" class="form-control" name="q" value="@Model.Q" placeholder="Search brands..." />

                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-search me-1"></i> Search
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                    <i class="fas fa-table me-1"></i>
                    Brand List
                </div>
                <a href="/Admin/Brand/Create" class="btn btn-primary btn-sm">
                    <i class="fas fa-plus me-1"></i> Create New
                </a>
            </div>
            <div class="card-body">
                @if (!Model.Brands.Any())
                {
                    <div class="text-center py-5 text-muted" style="display: flex;
                        justify-content: center;
                        flex-direction: column;">
                        @if (string.IsNullOrWhiteSpace(Model.Q))
                        {
                            <i class="fas fa-folder-open fa-3x mb-3 d-block"></i>
                            <h5>No brands yet</h5>
                            <p class="mb-3">Get started by creating your first brand.</p>
                            <a href="#" class="btn btn-primary">
                                <i class="fas fa-plus me-1"></i> Create New
                            </a>
                        }
                        else
                        {
                            <i class="fas fa-search fa-3x mb-3 d-block"></i>
                            <h5>No results for &ldquo;@Model.Q&rdquo;</h5>
                            <p class="mb-3">Try a different search term.</p>
                            <a href="/Admin/Brand/index" class="btn btn-outline-secondary">
                                <i class="fas fa-times me-1"></i> Clear Search
                            </a>
                        }
                    </div>
                }
                else
                {
                    <table id="datatablesSimple" class="table table-bordered table-striped table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th scope="col" style="width:60px;">#</th>
                                <th scope="col">Name</th>
                                <th scope="col">Status</th>
                                <th scope="col">Img</th>
                                <th scope="col" class="text-center" style="width:160px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Brands)
                            {
                                <tr>
                                    <td>@item.Id</td>
                                    <td>@item.Name</td>
                                    <td>
                                        @if (item.Status)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactive</span>
                                        }
                                    </td>
                                    <td><img src="~/images/brands/@item.Logo" width="150px" /></td>
                                    <td class="text-center">
                                        <a href="/Admin/Brand/Edit/@item.Id" class="btn btn-warning btn-sm me-1" title="Edit">
                                            <i class="fas fa-edit"></i> Edit
                                        </a>
                                        <a href="/Admin/Brand/Delete/@item.Id"
                                           class="btn btn-danger btn-sm btn-delete" title="Delete"
                                           data-name="@item.Name">
                                            <i class="fas fa-trash"></i> Delete
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
            <div class="card-footer d-flex justify-content-between align-items-center">
                <span class="text-muted small">Showing page @Model.CurrentPage</span>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        @if (Model.CurrentPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" href="/Admin/Brand/index?pg=@(Model.CurrentPage - 1)">&laquo; Prev</a>
                            </li>
                        }
                        <li class="page-item" style="display: flex;"> 
                            @for(int i = 1; i <= Model.TotalPages; i++)
                            {
                                if (@Model.CurrentPage == i)
                                {
                                    <a class="page-link active" href="/Admin/Brand/index?pg=@i">@i</a>
                                }
                                else
                                {
                                    <a class="page-link" href="/Admin/Brand/index?pg=@i">@i</a>
                                }
                            }
                        </li>
                        <li class="page-item">
                            @if (Model.CurrentPage < Model.TotalPages)
                            {
                                <a class="page-link" href="/Admin/Brand/index?pg=@(Model.CurrentPage + 1)">Next &raquo;</a>
                            }
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</main>

@section scripts {
    <script>
        document.querySelectorAll('.btn-delete').forEach(btn => {
            btn.addEventListener('click', function (e) {
                e.preventDefault();
                const url = this.href;
                const name = this.dataset.name;
                Swal.fire({
                    title: 'Delete Brand?',
                    text: `"${name}" will be permanently removed.`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#dc3545',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Yes, delete it',
                    cancelButtonText: 'Cancel'
                }).then(result => {
                    if (result.isConfirmed) window.location.href = url;
                });
            });
        });
    </script>
}
