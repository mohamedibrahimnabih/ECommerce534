@model Brand

<main>
    <div class="container-fluid px-4">
        <h1 class="mt-4">Brands</h1>
        <ol class="breadcrumb mb-4">
            <li class="breadcrumb-item"><a href="#">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="/Admin/Brand/index">Brands</a></li>
            <li class="breadcrumb-item active">Create</li>
        </ol>

        <div class="card mb-4">
            <div class="card-header">
                <i class="fas fa-plus me-1"></i>
                Create Brand
            </div>
            <div class="card-body">
                <form enctype="multipart/form-data" method="post">
                    <div class="mb-3">
                        <label for="Name" class="form-label fw-semibold">Name</label>
                        <input type="text" class="form-control" id="Name" name="name" value="@Model.Name" placeholder="Enter brand name" />
                    </div>

                    <div class="mb-3">
                        <label for="Logo" class="form-label fw-semibold">Logo</label>
                        <input type="file" class="form-control" id="Logo" name="logo" accept=".jpg, .jpeg, .png" />
                    </div>

                    <div class="mb-3">
                        @if (Model.Logo == null)
                        {
                            <img id="logoPreview" src="#" width="300px" style="display:none;" />
                            <div id="noImgMsg" class="display-6">Img Not Found!</div>
                        }
                        else
                        {
                            <img id="logoPreview" src="~/images/brands/@Model.Logo" width="300px" />
                        }
                    </div>

                    <div class="mb-4">
                        <label for="Status" class="form-label fw-semibold">Status</label>
                        <select class="form-select" name="status" id="Status">
                            @if (Model.Status)
                            {
                                <option value="true" selected>Active</option>
                                <option value="false">In Active</option>
                            }
                            else
                            {
                                <option value="true">Active</option>
                                <option value="false" selected>In Active</option>
                            }
                        </select>
                        <span class="text-danger small" asp-validation-for="Status"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-1"></i> Save
                        </button>
                        <a href="/Admin/Brand/index" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left me-1"></i> Back
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <script>
        document.getElementById('Logo').addEventListener('change', function () {
            const file = this.files[0];
            if (!file) return;
            const preview = document.getElementById('logoPreview');
            const noImg = document.getElementById('noImgMsg');
            preview.src = URL.createObjectURL(file);
            preview.style.display = 'block';
            if (noImg) noImg.style.display = 'none';
        });
    </script>
}
