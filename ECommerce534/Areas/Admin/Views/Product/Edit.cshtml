@model UpdateProductResponseVM

<main>
    <div class="container-fluid px-4">
        <h1 class="mt-4">Products</h1>
        <ol class="breadcrumb mb-4">
            <li class="breadcrumb-item"><a href="#">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="/Admin/Product/index">Products</a></li>
            <li class="breadcrumb-item active">Edit</li>
        </ol>

        <div class="card mb-4">
            <div class="card-header">
                <i class="fas fa-edit me-1"></i>
                Edit Product
            </div>
            <div class="card-body">
                <form enctype="multipart/form-data" method="post">
                    <input type="hidden" name="Id" value="@Model.Product.Id" />

                    <div class="mb-3">
                        <label for="Name" class="form-label fw-semibold">Name</label>
                        <input type="text" class="form-control" id="Name" name="Name" value="@Model.Product.Name" placeholder="Enter product name" />
                    </div>

                    <div class="mb-3">
                        <label for="MainImg" class="form-label fw-semibold">MainImg</label>
                        <input type="file" class="form-control" id="MainImg" name="MainImg" accept=".jpg, .jpeg, .png" />
                    </div>

                    <div class="mb-3">
                        @if (Model.Product.MainImg == null)
                        {
                            <img id="logoPreview" src="#" width="300px" style="display:none;" />
                            <div id="noImgMsg" class="display-6">Img Not Found!</div>
                        }
                        else
                        {
                            <img id="logoPreview" src="~/images/products/@Model.Product.MainImg" width="300px" />
                        }
                    </div>

                    <div class="mb-3">
                        <label for="SubImgs" class="form-label fw-semibold">SubImgs</label>
                        <input type="file" class="form-control" id="SubImgs" name="SubImgs" multiple accept=".jpg, .jpeg, .png" />
                    </div>

                    @if (Model.ProductSubImgs.Any())
                    {
                        <div class="mb-3 d-flex flex-wrap gap-3">
                            @foreach (var sub in Model.ProductSubImgs)
                            {
                                <div class="d-flex flex-column align-items-center gap-1">
                                    <img src="~/images/products/sub-imgs/@sub.SubImg" width="120px" class="rounded border" />
                                    <a href="/Admin/Product/DeleteSubImg?productId=@Model.Product.Id&subImgId=@sub.Id"
                                       class="btn btn-danger btn-sm w-100">
                                        <i class="fas fa-trash me-1"></i> Delete
                                    </a>
                                </div>
                            }
                        </div>
                    }

                    <div class="mb-3">
                        <label for="Description" class="form-label fw-semibold">Description</label>
                        <textarea class="form-control" id="Description" name="Description" rows="3">@Model.Product.Description</textarea>
                    </div>

                    <div class="mb-3">
                        <label for="Price" class="form-label fw-semibold">Price</label>
                        <input type="text" class="form-control" id="Price" name="Price" value="@Model.Product.Price" placeholder="Enter product price" />
                    </div>

                    <div class="mb-3">
                        <label for="Discount" class="form-label fw-semibold">Discount</label>
                        <input type="text" class="form-control" id="Discount" name="Discount" value="@Model.Product.Discount" placeholder="Enter discount" />
                    </div>

                    <div class="mb-3">
                        <label for="Quantity" class="form-label fw-semibold">Quantity</label>
                        <input type="text" class="form-control" id="Quantity" name="Quantity" value="@Model.Product.Quantity" placeholder="Enter quantity" />
                    </div>

                    <div class="mb-3">
                        <label for="Status" class="form-label fw-semibold">Status</label>
                        <select class="form-select" name="status" id="Status">
                            @if(Model.Product.Status)
                            {
                                <option value="true" selected>Active</option>
                                <option value="false">In Active</option>
                            }
                            else 
                            {
                                <option value="true">Active</option>
                                <option value="false" selected>In Active</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="categoryId" class="form-label fw-semibold">Category</label>
                        <select class="form-select" name="categoryId">
                            @foreach (var item in Model.Categories)
                            {
                                @if(Model.Product.CategoryId == item.Id)
                                {
                                    <option value="@item.Id" selected>@item.Name</option>
                                }
                                else
                                {
                                    <option value="@item.Id">@item.Name</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-4">
                        <label for="brandId" class="form-label fw-semibold">Brand</label>
                        <select class="form-select" name="brandId">
                            @foreach (var item in Model.Brands)
                            {
                                @if (Model.Product.BrandId == item.Id)
                                {
                                    <option value="@item.Id" selected>@item.Name</option>
                                }
                                else
                                {
                                    <option value="@item.Id">@item.Name</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Colors</label>
                        <div id="colorsContainer">
                            @if (Model.ProductColors.Any())
                            {
                                @foreach (var color in Model.ProductColors)
                                {
                                    <div class="color-row d-flex align-items-center gap-2 mb-2">
                                        <input type="color" class="form-control form-control-color" name="Colors" value="@color.Color" title="Pick a color" />
                                        <button type="button" class="btn btn-success btn-sm add-color-btn">
                                            <i class="fas fa-plus"></i>
                                        </button>
                                        <button type="button" class="btn btn-danger btn-sm remove-color-btn">
                                            <i class="fas fa-minus"></i>
                                        </button>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="color-row d-flex align-items-center gap-2 mb-2">
                                    <input type="color" class="form-control form-control-color" name="Colors" value="#000000" title="Pick a color" />
                                    <button type="button" class="btn btn-success btn-sm add-color-btn">
                                        <i class="fas fa-plus"></i>
                                    </button>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-1"></i> Save
                        </button>
                        <a href="/Admin/Product/index" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left me-1"></i> Back
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</main>

<script>
    document.getElementById('MainImg').addEventListener('change', function () {
        const file = this.files[0];
        if (!file) return;
        const preview = document.getElementById('logoPreview');
        const noImg = document.getElementById('noImgMsg');
        preview.src = URL.createObjectURL(file);
        preview.style.display = 'block';
        if (noImg) noImg.style.display = 'none';
    });

    document.getElementById('colorsContainer').addEventListener('click', function (e) {
        if (e.target.closest('.add-color-btn')) {
            const container = document.getElementById('colorsContainer');
            const newRow = document.createElement('div');
            newRow.className = 'color-row d-flex align-items-center gap-2 mb-2';
            newRow.innerHTML = `
                <input type="color" class="form-control form-control-color" name="Colors" value="#000000" title="Pick a color" />
                <button type="button" class="btn btn-success btn-sm add-color-btn">
                    <i class="fas fa-plus"></i>
                </button>
                <button type="button" class="btn btn-danger btn-sm remove-color-btn">
                    <i class="fas fa-minus"></i>
                </button>
            `;
            container.appendChild(newRow);
        }

        if (e.target.closest('.remove-color-btn')) {
            e.target.closest('.color-row').remove();
        }
    });
</script>
